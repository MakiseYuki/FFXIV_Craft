<Project Sdk="Dalamud.NET.Sdk/13.1.0">
  <PropertyGroup>
    <!-- This machine launches the game via FFXIVSimpleLauncher, whose bundled Dalamud
         (v13.x, .NET 9) is older than the mainline XIVLauncher dev-hooks reference.
         Point DalamudLibPath there so we compile/reference against the Dalamud build
         that actually gets injected at runtime. Override with DALAMUD_HOME env var if needed. -->
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' == ''">$(APPDATA)\FFXIVSimpleLauncher\Dalamud\Injector\</DalamudLibPath>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CusCraftPlugin</AssemblyName>
    <RootNamespace>CusCraftPlugin</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.1.1.0</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
  </PropertyGroup>

</Project>
